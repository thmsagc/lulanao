---
import { SITE } from '../config';
import { carregarConteudo, marcar, seloHTML, idsCitados, type Post } from '../lib/conteudo';
import Bloco from './Bloco.astro';
import Recibo from './Recibo.astro';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const p = post.data;
const c = await carregarConteudo();
const m = (t: string) => marcar(t, c);
const selos = (ids: string[] = []) => ids.map((id) => seloHTML(id, c.fontes)).join('');
const eixo = c.eixos.find((e) => e.id === p.eixo)!.data;
const moeda = p.moeda ? c.moedas.find((x) => x.id === p.moeda) : undefined;
const face = p.face;

const camadas = ['Capa', 'Entenda', 'Prova', 'Outro lado', 'Pense nisso', 'Fontes'];
const ids = (v: unknown) => [...idsCitados(v)].join(',');
const todasAsFontes = [...idsCitados(p)];
const temDetalhe = (blocos: { detalhe?: boolean }[]) => blocos.some((b) => b.detalhe);

const url = `${SITE.url}/p/${post.id}`;
const textoZap = `${p.kit.frase}\n\nFonte: ${p.kit.fonte}\n${url}`;
const n = p.capa.numero;
const numeroFormatado = n ? n.valor.toLocaleString('pt-BR', { minimumFractionDigits: n.decimais, maximumFractionDigits: n.decimais }) : '';
---
<article class={`deck t-${face}`} id={`p-${post.id}`} data-deck data-slug={post.id} data-moeda={p.moeda} aria-label={p.titulo}>
  <nav class="trilho" aria-label="Camadas deste assunto">
    {camadas.map((nome, i) => <button type="button" data-ir-camada={i} class={i === 0 ? 'feito' : ''} aria-label={`${i + 1}. ${nome}`}></button>)}
  </nav>
  <div class="topo">
    <span class="eixo">{eixo.icone} {eixo.nome}</span>
    <button type="button" class="botao-ouvir" data-ouvir aria-pressed="false"><span aria-hidden="true">🔊</span> Ouvir</button>
  </div>

  <div class="camadas" data-camadas>
    <!-- 0 · CAPA -->
    <section class="camada capa" data-fontes={ids(p.capa)} aria-label="Capa">
      <div class="conteudo">
        {p.capa.kicker && p.capa.kicker !== eixo.nome && <p class="kicker">{p.capa.kicker}</p>}
        {n ? (
          <>
            <p class="numero-capa" aria-label={`${n.prefixo}${numeroFormatado}${n.sufixo}`}>
              {n.prefixo}<span data-contar data-valor={n.valor} data-decimais={n.decimais}>{numeroFormatado}</span><small>{n.sufixo}</small>
            </p>
            <h2 class="titulo-capa" set:html={m(p.capa.titulo)} />
          </>
        ) : (
          <h2 class="titulo-capa grande" set:html={m(p.capa.titulo)} />
        )}
        {p.capa.subtitulo && <p class="subtitulo-capa" set:html={m(p.capa.subtitulo)} />}
        <div class="fontes-capa" set:html={selos(p.capa.fontes)} />
        <div class="acoes" data-nao-ler>
          <button type="button" class="botao" data-ir="proxima">Entenda <span aria-hidden="true">→</span></button>
          <button type="button" class="dica-baixo" data-ir="proximo-deck"><i aria-hidden="true">↑</i> Próximo assunto</button>
        </div>
      </div>
    </section>

    <!-- 1 · ENTENDA -->
    <section class="camada" data-fontes={ids(p.entenda)} aria-label="Entenda">
      <div class="conteudo">
        <p class="nome-camada" data-nao-ler>2 · Entenda</p>
        {p.entenda.map((b) => <Bloco bloco={b} faceBase={face} />)}
        <div class="acoes" data-nao-ler>
          <button type="button" class="botao" data-ir="proxima">Ver a prova <span aria-hidden="true">→</span></button>
          {temDetalhe(p.entenda) && <button type="button" class="botao vazado ver-detalhes" data-ver-detalhes>+ Detalhes</button>}
        </div>
      </div>
    </section>

    <!-- 2 · PROVA -->
    <section class="camada" data-fontes={ids(p.prova)} aria-label="Prova">
      <div class="conteudo">
        <p class="nome-camada" data-nao-ler>3 · A prova</p>
        {p.prova.map((b) => <Bloco bloco={b} faceBase={face} />)}
        <div class="acoes" data-nao-ler>
          <button type="button" class="botao" data-ir="proxima">Outro lado <span aria-hidden="true">→</span></button>
          {temDetalhe(p.prova) && <button type="button" class="botao vazado ver-detalhes" data-ver-detalhes>+ Detalhes</button>}
        </div>
      </div>
    </section>

    <!-- 3 · OUTRO LADO -->
    <section class="camada" data-fontes={ids(p.outroLado)} aria-label="Outro lado">
      <div class="conteudo">
        <p class="nome-camada" data-nao-ler>4 · O outro lado</p>
        {p.outroLado.map((b) => <Bloco bloco={b} faceBase={face} />)}
        <div class="acoes" data-nao-ler>
          <button type="button" class="botao" data-ir="proxima">Pense nisso <span aria-hidden="true">→</span></button>
        </div>
      </div>
    </section>

    <!-- 4 · PENSE NISSO -->
    <section class="camada" data-fontes={ids(p.penseNisso)} aria-label="Pense nisso">
      <div class="conteudo">
        <p class="nome-camada" data-nao-ler>5 · Pense nisso</p>
        <p class="pergunta-final">{p.penseNisso.pergunta}</p>
        {p.penseNisso.quiz && (
          <div class="quiz" data-quiz data-correta={p.penseNisso.quiz.correta}>
            <p>{p.penseNisso.quiz.pergunta}</p>
            <div class="quiz-opcoes" data-nao-ler>
              {p.penseNisso.quiz.opcoes.map((o, i) => <button type="button" data-opcao={i}>{o}</button>)}
            </div>
            <p class="quiz-explicacao"><strong data-quiz-resultado></strong> <span set:html={m(p.penseNisso.quiz.explicacao) + selos(p.penseNisso.quiz.fontes)} /></p>
          </div>
        )}
        <div class="kit" data-kit data-frase={p.kit.frase} data-kit-fonte={p.kit.fonte} data-url={url} data-face={face} data-kicker={eixo.nome} data-nao-ler>
          <p class="nome-camada">Mande para quem precisa ver</p>
          <div class="linha-botoes">
            <a class="botao zap" href={`https://wa.me/?text=${encodeURIComponent(textoZap)}`} target="_blank" rel="noopener">WhatsApp</a>
            <button type="button" class="botao vazado" data-kit-imagem>Imagem</button>
            <button type="button" class="botao vazado" data-kit-compartilhar>Enviar</button>
          </div>
        </div>
        {moeda && (
          <a class="cartao-moeda" href={`/duas-faces/${moeda.id}`} data-nao-ler>
            <span class="moedinha" aria-hidden="true">↻</span>
            <span><strong>Vire a moeda</strong><span>O que a esquerda e a direita defendem sobre {moeda.data.titulo.toLowerCase()}</span></span>
          </a>
        )}
        <div class="acoes" data-nao-ler>
          <button type="button" class="botao vazado" data-ir="proxima">Ver as fontes <span aria-hidden="true">→</span></button>
          <button type="button" class="dica-baixo" data-ir="proximo-deck"><i aria-hidden="true">↑</i> Próximo assunto</button>
        </div>
      </div>
    </section>

    <!-- 5 · FONTES -->
    <section class="camada" data-fontes={todasAsFontes.join(',')} aria-label="Fontes">
      <div class="conteudo">
        <p class="nome-camada" data-nao-ler>6 · Recibo de fontes</p>
        <Recibo ids={todasAsFontes} atualizadoEm={p.atualizadoEm} />
        <div class="acoes" data-nao-ler>
          <a class="botao vazado" href="/fontes">Biblioteca de Fontes</a>
          <button type="button" class="dica-baixo" data-ir="proximo-deck"><i aria-hidden="true">↑</i> Próximo assunto</button>
        </div>
      </div>
    </section>
  </div>
</article>
