---
import { SITE } from '../config';
import { carregarConteudo, idsCitados, type Post } from '../lib/conteudo';
import SlideView from './Slide.astro';
import Recibo from './Recibo.astro';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const p = post.data;
const c = await carregarConteudo();
const eixo = c.eixos.find((e) => e.id === p.eixo)!.data;
const moeda = p.moeda ? c.moedas.find((x) => x.id === p.moeda) : undefined;
const todasAsFontes = [...idsCitados(p.slides)];
const url = `${SITE.url}/p/${post.id}`;
const textoZap = `${p.kit.frase}\n\nFonte: ${p.kit.fonte}\n${url}`;
const slides = p.slides;
const faceInicial = slides[0].face ?? (slides[0].tipo === 'esquerda' ? 'vermelha' : slides[0].tipo === 'direita' || slides[0].tipo === 'fecho' ? 'azul' : 'neutra');
const ultimoEhFecho = slides[slides.length - 1].tipo === 'fecho';
---
<article class={`deck t-${faceInicial}`} id={`p-${post.id}`} data-deck data-slug={post.id} data-moeda={p.moeda} aria-label={p.titulo}>
  <nav class="trilho" aria-label="Slides deste assunto">
    {slides.map((s, i) => <button type="button" data-ir-camada={i} class={i === 0 ? 'feito' : ''} aria-label={`Slide ${i + 1}`}></button>)}
  </nav>
  <div class="topo">
    <span class="eixo">{eixo.icone} {eixo.nome}</span>
    <button type="button" class="botao-ouvir" data-ouvir aria-pressed="false"><span aria-hidden="true">🔊</span> Ouvir</button>
  </div>

  <div class="camadas" data-camadas>
    {slides.map((s, i) => (
      <SlideView slide={s} id={`${post.id}-${i}`} ultimo={i === slides.length - 1}>
        {i === 0 && (
          <p class="dica-gesto" data-nao-ler><span aria-hidden="true">👉</span> Deslize para o lado · <span aria-hidden="true">☝</span> para cima: próximo assunto</p>
        )}
        {i === slides.length - 1 && ultimoEhFecho && (
          <>
            <div class="kit" data-kit data-frase={p.kit.frase} data-kit-fonte={p.kit.fonte} data-url={url} data-face={p.kit.face} data-kicker={eixo.nome} data-nao-ler>
              <div class="linha-botoes">
                <a class="botao zap" href={`https://wa.me/?text=${encodeURIComponent(textoZap)}`} target="_blank" rel="noopener">WhatsApp</a>
                <button type="button" class="botao vazado" data-kit-imagem>Imagem</button>
                <button type="button" class="botao vazado" data-kit-compartilhar>Enviar</button>
              </div>
            </div>
            {moeda && (
              <a class="cartao-moeda" href={`/duas-faces/${moeda.id}`} data-nao-ler>
                <span class="moedinha" aria-hidden="true">↻</span>
                <span><strong>Vire a moeda</strong><span>Esquerda × direita: {moeda.data.titulo.toLowerCase()}</span></span>
              </a>
            )}
            <div class="acoes" data-nao-ler>
              <button type="button" class="botao vazado" data-folha-tpl={`recibo-${post.id}`}>Ver as {todasAsFontes.length} fontes</button>
              <button type="button" class="dica-baixo" data-ir="proximo-deck"><i aria-hidden="true">↑</i> Próximo assunto</button>
            </div>
          </>
        )}
      </SlideView>
    ))}
  </div>

  <template id={`recibo-${post.id}`}>
    <div class="mais">
      <span class="etiqueta">Todas as fontes</span>
      <h3>{p.titulo}</h3>
      <Recibo ids={todasAsFontes} atualizadoEm={p.atualizadoEm} />
      <a class="botao vazado" href="/fontes" style="justify-self:start">Biblioteca de Fontes</a>
    </div>
  </template>
</article>
