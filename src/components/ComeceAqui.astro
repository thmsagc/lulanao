---
import { SITE } from '../config';
import { carregarConteudo, marcar } from '../lib/conteudo';
const c = await carregarConteudo();
interface Props { eixoNome: string; eixoIcone: string; eixoPergunta: string }
const { eixoNome, eixoIcone } = Astro.props;
---
<article class="deck t-neutra" id="p-comece-aqui" data-deck data-slug="" aria-label="Comece aqui">
  <nav class="trilho" aria-label="Slides">
    <button type="button" data-ir-camada="0" class="feito" aria-label="Slide 1"></button>
    <button type="button" data-ir-camada="1" aria-label="Slide 2"></button>
  </nav>
  <div class="topo">
    <span class="eixo">Comece aqui</span>
    <button type="button" class="botao-ouvir" data-ouvir aria-pressed="false"><span aria-hidden="true">🔊</span> Ouvir</button>
  </div>
  <div class="camadas" data-camadas>
    <section class="camada slide t-neutra" data-face="neutra" aria-label="Boas-vindas">
      <div class="conteudo">
        <h1 class="intro-marca"><span>Lula</span><span class="nao">Não</span></h1>
        <p class="slide-frase media">{SITE.lema}</p>
        <p class="slide-contexto">Este site tem lado: o da direita. Mostramos o que a esquerda fez com o Brasil, com a fonte de cada frase.</p>
        <p class="slide-contexto" set:html={marcar('==46%== dos brasileiros se colocam à direita. Só 29%, à esquerda. [[datafolha-ideologia-2025]]', c)} />
        <div class="slide-acoes" data-nao-ler>
          <button type="button" class="botao-mais" data-ir="proximo-deck">Começar <span aria-hidden="true">↓</span></button>
          <button type="button" class="botao-seta" data-ir="proxima" aria-label="Como funciona">→</button>
        </div>
      </div>
    </section>
    <section class="camada slide t-neutra" data-face="neutra" aria-label="Como funciona">
      <div class="conteudo">
        <p class="slide-rotulo" data-nao-ler>Como funciona</p>
        <div class="gestos">
          <div class="gesto"><span class="mao cima" aria-hidden="true"><span>☝</span></span><p><strong>Para cima:</strong> próximo assunto.</p></div>
          <div class="gesto"><span class="mao lado" aria-hidden="true"><span>👉</span></span><p><strong>Para o lado:</strong> mais do mesmo assunto.</p></div>
          <div class="gesto"><span class="mao" aria-hidden="true"><span>＋</span></span><p><strong>Quero entender melhor:</strong> abre os detalhes sem sair daqui.</p></div>
        </div>
        <div class="legenda-intro">
          <div><i style="background:var(--esq)"></i><p><strong>Vermelho:</strong> o que a esquerda fez.</p></div>
          <div><i style="background:var(--dir)"></i><p><strong>Azul:</strong> o que nós defendemos.</p></div>
          <div><i style="background:var(--papel)"></i><p><strong>Papel:</strong> fatos e números.</p></div>
        </div>
        <p class="slide-contexto">Tema de hoje: {eixoIcone} {eixoNome}</p>
        <div class="slide-acoes" data-nao-ler>
          <button type="button" class="botao-mais" data-ir="proximo-deck">Começar <span aria-hidden="true">↓</span></button>
        </div>
      </div>
    </section>
  </div>
</article>
