---
import { carregarConteudo, type Moeda } from '../lib/conteudo';
import SlideView from './Slide.astro';
import FoiceMartelo from './FoiceMartelo.astro';

interface Props {
  moeda: Moeda;
  lado: 'vermelha' | 'azul';
}
const { moeda, lado } = Astro.props;
const f = moeda.data[lado];
await carregarConteudo();
const outra = lado === 'vermelha' ? 'a direita' : 'a esquerda';
const total = f.slides.length + 1;
---
<section class={`face face-${lado} t-${lado} deck`} data-deck data-face={lado} aria-label={f.rotulo}>
  <nav class="trilho" aria-label={`Slides: ${f.rotulo}`}>
    {Array.from({ length: total }, (_, i) => <button type="button" data-ir-camada={i} class={i === 0 ? 'feito' : ''} aria-label={`Slide ${i + 1}`}></button>)}
  </nav>
  <div class="topo">
    <span class="lado-titulo">
      {f.selo && (
        <button type="button" class="selo-comunista" data-folha-tpl={`selo-${moeda.id}`} aria-label="Por que a foice e o martelo?">
          <FoiceMartelo />
        </button>
      )}
      {f.rotulo}
    </span>
    <button type="button" class="botao-ouvir" data-ouvir aria-pressed="false"><span aria-hidden="true">🔊</span> Ouvir</button>
  </div>

  <div class="camadas" data-camadas>
    {f.slides.map((s, i) => (
      <SlideView slide={s} id={`${moeda.id}-${lado}-${i}`} forcarFace={lado}>
        {i === 0 && <button type="button" class="botao vazado" data-virar data-nao-ler style="justify-self:start">↻ Ver o que {outra} defende</button>}
      </SlideView>
    ))}
    <section class={`camada slide t-${lado}`} data-face={lado} aria-label="E você?">
      <div class="conteudo">
        <p class="slide-rotulo" data-nao-ler>E você?</p>
        <h2 class="slide-frase media">Qual face te convenceu?</h2>
        <div class="voce" data-nao-ler>
          <button type="button" data-escolha="azul" aria-pressed="false"><i></i> A face azul (direita)</button>
          <button type="button" data-escolha="vermelha" aria-pressed="false"><i></i> A face vermelha (esquerda)</button>
          <button type="button" data-escolha="pensando" aria-pressed="false"><i style="background:var(--papel)"></i> Ainda estou pensando</button>
        </div>
        <p class="voce-obrigado" hidden>Guardado só neste aparelho. <a href="/sua-moeda">Ver Sua Moeda →</a></p>
        <div class="acoes" data-nao-ler>
          <button type="button" class="botao vazado" data-folha-tpl={`placar-${moeda.id}`}>Os números</button>
          <button type="button" class="botao vazado" data-virar>↻ Virar a moeda</button>
        </div>
      </div>
    </section>
  </div>
</section>
