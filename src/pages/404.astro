---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada">
  <div class="pagina t-neutra">
    <div class="pagina-interno">
      <p class="kicker">Erro 404</p>
      <h1>Esta página não existe.</h1>
      <p class="intro">Mas a verdade continua aqui. Toque no botão dourado para navegar.</p>
      <a class="botao" href="/" style="justify-self:start">Voltar ao começo</a>
    </div>
  </div>
</Base>
